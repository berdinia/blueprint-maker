{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blueprint:schema:validation-report:1.0.0",
  "title": "Mechanical validation report",
  "description": "Results of mechanical checks. SKIP never counts as PASS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "counts",
    "checks",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "blueprint.validation-report"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "enum": [
        "PASS",
        "PARTIAL",
        "FAIL",
        "BLOCKED"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "category",
          "status",
          "detail"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "WARN",
              "FAIL",
              "SKIP"
            ]
          },
          "detail": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  }
}
