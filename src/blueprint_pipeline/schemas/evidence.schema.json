{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blueprint:schema:evidence:1.0.0",
  "title": "Evidence analysis",
  "description": "Source relationships, evidence origins, families, fragment classification, room-identity candidates and unresolved conflicts. Derived; never edited by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "relationships",
    "evidence_origins",
    "families",
    "fragments",
    "identity_candidates",
    "conflicts",
    "unresolved_questions"
  ],
  "properties": {
    "schema": {
      "const": "blueprint.evidence"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "a",
          "b",
          "kind",
          "asserted_by",
          "basis"
        ],
        "properties": {
          "a": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "b": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "kind": {
            "enum": [
              "EXACT_FILE_DUPLICATE",
              "SAME_SCAN_OR_PHOTO_VARIANT",
              "SAME_DRAWING_RESCANNED",
              "ANNOTATED_COPY",
              "REDRAWN_SAME_ROOM",
              "SUPPLEMENTARY_DETAIL",
              "POSSIBLE_REVISION",
              "CONFLICTING_VERSION",
              "POSSIBLY_SAME_SUBJECT",
              "UNRELATED",
              "UNKNOWN"
            ]
          },
          "asserted_by": {
            "enum": [
              "HUMAN",
              "HEURISTIC",
              "MODEL"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "basis": {
            "type": "string"
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "evidence_origins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin_id",
          "source_ids"
        ],
        "properties": {
          "origin_id": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            },
            "minItems": 1
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "source_ids",
          "origin_ids"
        ],
        "properties": {
          "family_id": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "origin_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "revision_groups": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              }
            }
          }
        }
      }
    },
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "fragment_class",
          "class_asserted_by",
          "placement_state"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "fragment_class": {
            "enum": [
              "WHOLE_FLOOR",
              "ROOM",
              "MULTI_ROOM_RELATIONSHIP",
              "CORRIDOR_OR_TRANSITION",
              "OPENING_DETAIL",
              "PARTIAL_WALL_OR_CORNER",
              "TEXT_OR_NOTES",
              "UNKNOWN"
            ]
          },
          "class_asserted_by": {
            "enum": [
              "HUMAN",
              "HEURISTIC",
              "MODEL"
            ]
          },
          "class_confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "placement_state": {
            "enum": [
              "ANCHORED",
              "LIKELY",
              "AMBIGUOUS",
              "UNPLACED",
              "DETAIL_ONLY"
            ]
          },
          "placement_basis": {
            "type": "string"
          },
          "origin_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "extraction_status": {
            "type": "string"
          }
        }
      }
    },
    "identity_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "label_normalized",
          "observation_ids",
          "source_ids",
          "origin_ids",
          "independent_origin_count",
          "status",
          "revision_state"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "label_normalized": {
            "type": [
              "string",
              "null"
            ]
          },
          "label_raw": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "origin_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "independent_origin_count": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "CANDIDATE",
              "CORROBORATED",
              "CONFLICTED",
              "UNRESOLVED"
            ]
          },
          "revision_state": {
            "enum": [
              "CURRENT",
              "POSSIBLE_REVISION",
              "SUPERSEDED",
              "CONFLICTING_VERSION",
              "UNKNOWN"
            ]
          },
          "measurements": {
            "type": "object",
            "additionalProperties": {
              "type": "array"
            }
          },
          "conflict_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conflict_id",
          "kind",
          "subject",
          "detail",
          "status"
        ],
        "properties": {
          "conflict_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "MEASUREMENT",
              "REVISION",
              "IDENTITY",
              "NAME",
              "PLACEMENT",
              "PROVENANCE"
            ]
          },
          "subject": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "values": {
            "type": "array"
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED_BY_DECISION"
            ]
          },
          "resolution": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "text"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
