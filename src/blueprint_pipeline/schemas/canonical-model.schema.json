              "AMBIGUOUS",
              "UNPLACED",
              "DETAIL_ONLY"
            ]
          },
          "revision_state": {
            "enum": [
              "CURRENT",
              "POSSIBLE_REVISION",
              "SUPERSEDED",
              "CONFLICTING_VERSION",
              "UNKNOWN"
            ]
          },
          "human_confirmation": {
            "enum": [
              "UNCONFIRMED",
              "CONFIRMED",
              "REJECTED"
            ]
          },
          "conflict_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hypothetical": {
            "type": "boolean"
          },
          "uncertainty": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "wall_id": {
            "type": "string"
          },
          "start_mm": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "end_mm": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "room_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "thickness_mm": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
