{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blueprint:schema:canonical-model:1.0.0",
  "title": "Canonical evidence model",
  "description": "The factual authority for rendering. Units are millimetres; Y axis points up. Every geometric feature is backed by sources and an explicit placement state, or is marked hypothetical.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "model_id",
    "units",
    "coordinate_system",
    "rooms",
    "walls",
    "openings",
    "adjacency",
    "measurements",
    "conflicts",
    "revisions",
    "decisions",
    "unresolved_questions",
    "fragments_unplaced",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "blueprint.canonical-model"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "model_id": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean"
    },
    "units": {
      "const": "mm"
    },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "y_axis",
        "status"
      ],
      "properties": {
        "y_axis": {
          "const": "up"
        },
        "origin": {
          "type": "string"
        },
        "status": {
          "enum": [
            "provisional",
            "anchored"
          ]
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "room_id",
          "display_name",
          "polygon_mm",
          "source_ids",
          "evidence_origin_ids",
          "confidence",
          "placement_state",
          "revision_state",
          "human_confirmation",
          "conflict_refs",
          "hypothetical",
          "raw_observation_ids"
        ],
        "properties": {
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          },
          "evidence_origin_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "raw_observation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "placement_state": {
            "enum": [
              "ANCHORED",
              "LIKELY",
              "AMBIGUOUS",
              "UNPLACED",
              "DETAIL_ONLY"
            ]
          },
          "revision_state": {
            "enum": [
              "CURRENT",
              "POSSIBLE_REVISION",
              "SUPERSEDED",
              "CONFLICTING_VERSION",
              "UNKNOWN"
            ]
          },
          "human_confirmation": {
            "enum": [
              "UNCONFIRMED",
              "CONFIRMED",
              "REJECTED"
            ]
          },
          "conflict_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hypothetical": {
            "type": "boolean"
          },
          "uncertainty": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "room_id": {
            "type": "string"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "name_candidates": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "identity_candidate_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "polygon_mm": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 3
              },
              {
                "type": "null"
              }
            ]
          },
          "measurement_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
