# Blueprint Reconstruction Scaffold — generic configuration
# Copy this to `config/local.env` and adjust for your local environment.
#
# NEVER commit real credentials or real project paths.

# ---- Model endpoints -------------------------------------------------------
# Set these to point at your local Ollama / proxy endpoints.
BLUEPRINT_NATIVE_ENDPOINT=http://127.0.0.1:11434
BLUEPRINT_PROXY_ENDPOINT=http://127.0.0.1:11435
BLUEPRINT_EXTRACT_MODEL=qwen3.8:27b
BLUEPRINT_REVIEW_MODEL=gemma4:31b

# ---- Project layout --------------------------------------------------------
# These are absolute or relative paths that your project layout provides.
# The pipeline uses them as defaults when environment overrides are not set.
PROJECT_ROOT=${PROJECT_ROOT:-.}
INPUT_DIR=${PROJECT_ROOT}/input
OUTPUT_DIR=${PROJECT_ROOT}/results
RENDER_DIR=${PROJECT_ROOT}/rendered
MODEL_DIR=${PROJECT_ROOT}/whole-house/model
SOURCE_REGISTRY=${PROJECT_ROOT}/source-registry.json

# ---- Rendering parameters ---------------------------------------------------
# Canonical unit is millimetres.
RENDER_PAGE_W_MM=210.0
RENDER_PAGE_H_MM=297.0
RENDER_MARGIN_MM=15.0
RENDER_TITLE_H_MM=26.0
RENDER_NOTES_H_MM=46.0
RENDER_GAP_MM=1600.0
RENDER_NOMINAL_PLACEHOLDER_MM=1400.0

# ---- Validation parameters ----------------------------------------------------
MIN_ROOM_FRAC=0.0008
GEOMETRY_MIN_FRAC=0.05
BG_THRESHOLD=250
