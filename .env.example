# blueprint-pipeline environment overrides (all optional).
# Precedence: defaults < YAML config < these variables < CLI --project.
# Never put secrets here: an API key is referenced by the NAME of a variable
# (BLUEPRINT_ENDPOINT_API_KEY_ENV) that you export separately in your shell.

# BLUEPRINT_CONFIG=blueprint.yaml
# BLUEPRINT_PROJECT_ROOT=.
# BLUEPRINT_INPUT_DIR=input
# BLUEPRINT_WORK_DIR=work
# BLUEPRINT_RESULTS_DIR=results

# Local-only: loopback by default. private_network also allows RFC 1918 / ULA /
# link-local literals and hostnames listed in privacy.allowed_hosts (YAML only).
# BLUEPRINT_PRIVACY_MODE=loopback

# BLUEPRINT_ENDPOINT_URL=http://127.0.0.1:11434
# BLUEPRINT_ENDPOINT_API=ollama              # or: openai
# BLUEPRINT_ENDPOINT_API_KEY_ENV=            # e.g. LOCAL_LLM_KEY (name, not value)
# BLUEPRINT_NATIVE_ENDPOINT_URL=
# BLUEPRINT_ENDPOINT_FALLBACK=false          # explicit opt-in; logged when used

# BLUEPRINT_EXTRACT_MODEL=<local vision model tag>
# BLUEPRINT_REVIEW_MODEL=<a different local vision model tag>

# BLUEPRINT_REQUEST_TIMEOUT_S=900
# BLUEPRINT_CONNECT_TIMEOUT_S=5
# BLUEPRINT_CONTEXT_SIZE=8192
# BLUEPRINT_MAX_OUTPUT_TOKENS=4096
# BLUEPRINT_MAX_IMAGE_PX=2048
# BLUEPRINT_MAX_IMAGE_BYTES=12000000
# BLUEPRINT_STREAM=true
# BLUEPRINT_RETRY_MAX_ATTEMPTS=2
# BLUEPRINT_LOCK_WAIT_S=0                    # 0 = refuse immediately when busy
